  "constraints": [
    {
      "name": "erp_company_pkey",
      "table": "erp_company",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "erp_customers_pkey",
      "table": "erp_customers",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "erp_document_items_document_id_fkey",
      "table": "erp_document_items",
      "definition": "FOREIGN KEY (document_id) REFERENCES erp_documents(id) ON DELETE CASCADE"
    },
    {
      "name": "erp_document_items_pkey",
      "table": "erp_document_items",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "erp_documents_customer_id_fkey",
      "table": "erp_documents",
      "definition": "FOREIGN KEY (customer_id) REFERENCES erp_customers(id) ON DELETE SET NULL"
    },
    {
      "name": "erp_documents_pkey",
      "table": "erp_documents",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "erp_documents_status_check",
      "table": "erp_documents",
      "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'sent'::text, 'approved'::text, 'cancelled'::text, 'paid'::text])))"
    },
    {
      "name": "erp_documents_type_check",
      "table": "erp_documents",
      "definition": "CHECK ((type = ANY (ARRAY['quote'::text, 'bill'::text, 'invoice'::text, 'receipt'::text])))"
    },
    {
      "name": "erp_products_pkey",
      "table": "erp_products",
